{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Executive Desk",
  "version": "2.0.0",
  "identifier": "com.cemmats.executivedesk",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Executive Desk",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CEMMATS",
    "shortDescription": "Executive Desk",
    "longDescription": "Executive assistant desk for the Office of the MD: commitments, files, research, social media, finance, diary, travel, meetings and a timeline, synced with the Android app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
